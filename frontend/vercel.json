{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://code-arena-backend-pjh9.onrender.com/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://code-arena-backend-pjh9.onrender.com/oauth2/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
