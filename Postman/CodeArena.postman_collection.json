            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"import sys\\nimport json\\n\\ndef twoSum(nums, target):\\n    seen = {}\\n    for i, num in enumerate(nums):\\n        diff = target - num\\n        if diff in seen:\\n            return [seen[diff], i]\\n        seen[num] = i\\n    return []\\n\\nif __name__ == '__main__':\\n    lines = sys.stdin.read().splitlines()\\n    if len(lines) >= 2:\\n        nums = json.loads(lines[0])\\n        target = int(lines[1])\\n        ans = twoSum(nums, target)\\n        print(json.dumps(ans))\",\n  \"language\": \"python\"\n}"
            },
